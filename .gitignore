# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Video masters. The web derivatives beside them are what ship; the masters are
# the source of truth and stay on disk. testimonial-bg.mp4 is 111 MiB, over
# GitHub's 100 MiB hard limit, so committing it makes the branch unpushable.
# Keep masters in shared storage (or Git LFS) rather than in history.
/public/videos/testimonial-bg.mp4
