{
  "name": "maison-palettia-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build && bash scripts/prune-standalone.sh",
    "start": "next start",
    "start:prod": "payload migrate && bash scripts/start-standalone.sh",
    "lint": "eslint",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "payload": "payload",
    "migrate": "payload migrate",
    "seed": "payload run cms/seed/index.ts",
    "preflight:db": "node scripts/preflight-db.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "ci": "bash scripts/ci.sh"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/live-preview-react": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "bowser": "^2.14.1",
    "framer-motion": "^13.2.0",
    "graphql": "^16.14.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.40.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.16",
    "payload": "^3.90.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "undici": "^7.29.1"
  }
