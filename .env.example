# ---------------------------------------------------------------------------
# Maison Palettia — environment. Exactly three keys (docs/cms/SPEC.md §C.1).
#
# Copy to `.env` — the ONLY env file this project uses, gitignored, read by
# both `next` and the `payload` CLI (docs/cms/DECISIONS.md). On the server
# the same three keys live in the host's `.env`.
#
# Nothing else belongs here. Everything the owner may need to change without
# a redeploy — Mamo Pay keys, SMTP, notification recipients, legal details,
# the public URL, analytics IDs — is a setting in the admin panel (SPEC §C.3),
# so adding a fourth key to this file is almost always the wrong fix.
# ---------------------------------------------------------------------------

# Postgres connection string for Payload (`@payloadcms/db-postgres`).
# Development and production point at the same owner-supplied database —
# there is no local Docker Postgres. That is safe only because the schema is
# never pushed from a laptop (`push: false`): after pulling, run
# `npx payload migrate`; after a schema change, `npx payload migrate:create`.
# In production the URL carries `?sslmode=verify-full&sslrootcert=…` (SPEC §A.5).
DATABASE_URL=postgres://user:password@host:5433/maison_palettia_prod

# Payload's auth secret and the HKDF root for every derived key: encrypted
# settings at rest, magic links, the session cookie, signed PDF/return links.
# Generate with `openssl rand -hex 32`. Rotating it without first running
# `cms/scripts/reseal.ts` makes every encrypted setting unreadable — see
# docs/cms-runbook.md before touching it on the server.
PAYLOAD_SECRET=

# The public origin of this deployment, scheme included, no trailing slash.
# REQUIRED in production: it is the admin's CSRF allowlist, and without it
# Payload accepts the auth cookie from any Origin. It is also the fallback for
# `metadataBase`, live preview and the password-reset link until
# `site-settings.publicUrl` has been saved in the admin, and it is what the
# CLI uses when there is no database in scope. The dev server runs on 3200
# (never 3000 — another project on this machine owns it).
NEXT_PUBLIC_SERVER_URL=http://localhost:3200
