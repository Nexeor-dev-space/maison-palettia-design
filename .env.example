# ---------------------------------------------------------------------------
# Maison Palettia — environment
#
# Copy to `.env.local` for development. On a deploy host, set these in that
# host's own environment panel instead; `.env.local` is gitignored and never
# reaches the server.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_WHATSAPP_NUMBER is no longer read. Both WhatsApp controls — the
# floating button and the bottom bar's slot — came off the site at the
# client's ask; <ContactWidget> and the bar's Contact slot link to /contact
# in their place. Setting it does nothing.

# Postgres connection for the Payload CMS (apps/cms). Required once the CMS lands.
DATABASE_URL=
